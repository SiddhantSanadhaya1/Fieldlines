{
  "name": "fieldlines-risk-scoring",
  "version": "1.0.0",
  "description": "Fieldlines supervisor review queue (FIEL-53, FIEL-60, FIEL-59)",
  "main": "dist/domain/risk/risk-scorer.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "test": "node --import tsx --test src/__tests__/*.test.ts",

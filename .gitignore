# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/

# Tooling scratch
.playwright-mcp/
*.log

# Code graph — generated on every push to main, published to the `graph` branch.
# Never committed to main; fetch with: git fetch origin graph
graphify-out/
graph.json
manifest.json
graph-viewer.html

# Vercel's local link, written by `vercel link`. Machine-specific.
.vercel

# Real credentials never get committed. The example file is the exception —
# it carries the variable names with no values, which is the point of it.
.env*
!.env.example

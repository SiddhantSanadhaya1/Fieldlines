# Telemetry — where runtime exceptions are exported.
#
# Mission Control is itself an OTLP receiver, so no third-party telemetry vendor
# is needed. Leave the endpoint unset and the app runs normally with telemetry
# disabled; a missing variable must never take down the review queue.
#
# The ingest key is issued per project in Mission Control:
#   Project screen -> Telemetry & Signals -> New key
# It is shown once and stored hashed, so copy it when it is created.
OTEL_SERVICE_NAME=fieldlines-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8080/v1/traces
MISSION_CONTROL_INGEST_KEY=

# Where the browser finds the API. Empty means same origin, which is correct on
# Vercel; set it when running the Vite dev server and the API on different ports.
VITE_API_BASE=
